  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "title": "Accountid"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accountId",
          "email"
        ],
        "title": "AccountOut"
      },
      "Ack": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Ack"
      },
      "ChallengeIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ChallengeIn"
      },
      "ChallengeOut": {
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "title": "Challengeid"
          },
          "expiresInSeconds": {
            "type": "integer",
            "title": "Expiresinseconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challengeId",
          "expiresInSeconds"
        ],
        "title": "ChallengeOut"
      },
      "Entitlement": {
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "title": "Accountid"
          },
          "paid": {
            "type": "boolean",
            "title": "Paid"
          },
          "activeUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
