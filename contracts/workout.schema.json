{
  "$defs": {
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "durationSeconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Durationseconds",
          "type": "integer"
        },
        "speedKmh": {
          "exclusiveMinimum": 0,
          "maximum": 40,
          "title": "Speedkmh",
          "type": "number"
        },
        "inclinePercent": {
          "maximum": 40,
          "minimum": -30,
          "title": "Inclinepercent",
          "type": "number"
        }
      },
      "required": [
        "durationSeconds",
        "speedKmh",
        "inclinePercent"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "workoutId": {
      "format": "uuid",
      "title": "Workoutid",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "recordedAt": {
      "format": "date-time",
      "title": "Recordedat",
      "type": "string"
    },
    "activity": {
      "enum": [
        "walking",
        "running"
      ],
      "title": "Activity",
      "type": "string"
    },
    "environment": {
      "enum": [
        "treadmill",
        "outdoor"
      ],
      "title": "Environment",
      "type": "string"
    },
    "durationSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Durationseconds",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "maxItems": 1000,
      "title": "Segments",
      "type": "array"
    },
    "distanceMeters": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distancemeters"
    },
    "weightKgAtWorkout": {
      "exclusiveMinimum": 0,
      "maximum": 500,
      "title": "Weightkgatworkout",
      "type": "number"
    },
    "actual": {
      "const": true,
      "default": true,
      "title": "Actual",
      "type": "boolean"
    }
  },
  "required": [
    "workoutId",
    "revision",
    "recordedAt",
    "activity",
    "environment",
    "durationSeconds",
    "weightKgAtWorkout"
  ],
  "title": "Workout",
  "type": "object"
}
